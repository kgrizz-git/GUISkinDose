{
  "version": 1,
  "receipt_max_age_hours": 168,
  "protected_ignore_patterns": [
    "logs/",
    "*.cache",
    "*.err",
    "*.log",
    "*.log.[0-9]*",
    "*.out",
    "*.pkl",
    "*.pickle",
    "*.trace",
    "tmp/",
    "PlotOutputs/",
    "test_data_gitignored/",
    "build/",
    "dist/",
    "site/",
    "docs/_build/",
    "htmlcov/",
    ".coverage",
    "coverage.xml",
    ".coverage.*",
    ".pytest_cache/",
    ".mypy_cache/",
    ".ruff_cache/",
    ".venv/",
    "[Vv]env/",
    "venv/",
    ".direnv/",
    "backups/",
    ".scannerwork/",
    ".sonar/",
    ".privacy-scan-state/",
    "sonar-project.properties.local"
  ],
  "never_track_prefixes": [
    "logs/",
    "tmp/",
    "PlotOutputs/",
    "test_data_gitignored/",
    "build/",
    "dist/",
    "site/",
    "docs/_build/",
    "htmlcov/",
    ".pytest_cache/",
    ".mypy_cache/",
    ".ruff_cache/",
    ".venv/",
    "venv/",
    ".direnv/",
    "backups/",
    ".scannerwork/",
    ".sonar/",
    ".privacy-scan-state/"
  ],
  "never_track_names": [
    ".DS_Store",
    "sonar-project.properties.local"
  ],
  "never_track_patterns": [
    "*.cache", "*.err", "*.log", "*.log.[0-9]*", "*.out", "*.pkl", "*.pickle", "*.trace",
    ".coverage", "coverage.xml", ".coverage.*", "*.tmp", "*.bak", "*.orig", "debug_*", "scratch*",
    "temp*", "_test_gui_import.py", "src/mypyskindose/example_data/RDSR/clinical*"
  ],
  "phi_filename": {
    "_comment": "Blocks committing/tracking files whose NAME OR PATH looks like it embeds PHI (a patient identifier or a person's name). Matched over the full normalized POSIX path, case-insensitively. Structural patterns are regexes; name_tokens are matched as whole tokens after splitting the path on non-alphanumerics. Add legitimate exceptions to allowlist_patterns (fnmatch globs over the full path). See dev-docs/PRIVACY_AND_SENSITIVE_ASSETS.md.",
    "structural_patterns": [
      "(?<![a-z0-9])mrn[ _\\-]?\\d",
      "(?<![a-z0-9])mrn[ _\\-](?=[a-z0-9])",
      "(?<![a-z0-9])ssn(?![a-z0-9])",
      "(?<![a-z0-9])ssn[ _\\-]?\\d",
      "(?<!\\d)\\d{3}-\\d{2}-\\d{4}(?!\\d)",
      "(?<![a-z0-9])dob[ _\\-]?\\d",
      "date[ _\\-]?of[ _\\-]?birth",
      "patient[ _\\-]?(name|id|mrn)",
      "(?<![a-z0-9])pt[ _\\-]?(name|mrn)(?![a-z0-9])",
      "(?<![a-z0-9])acc(ession)?[ _\\-]?(#|\\d)"
    ],
    "name_tokens": [
      "james", "john", "robert", "michael", "william", "david", "richard", "joseph", "thomas",
      "charles", "christopher", "daniel", "matthew", "anthony", "mark", "donald", "steven", "paul",
      "andrew", "joshua", "kenneth", "kevin", "brian", "george", "edward", "ronald", "timothy",
      "jason", "jeffrey", "ryan", "jacob", "gary", "nicholas", "eric", "jonathan", "stephen",
      "larry", "justin", "scott", "brandon", "benjamin", "samuel", "gregory", "frank", "alexander",
      "raymond", "patrick", "jack", "dennis", "jerry", "mary", "patricia", "jennifer", "linda",
      "elizabeth", "barbara", "susan", "jessica", "sarah", "karen", "nancy", "lisa", "margaret",
      "betty", "sandra", "ashley", "dorothy", "kimberly", "emily", "donna", "michelle", "carol",
      "amanda", "melissa", "deborah", "stephanie", "rebecca", "laura", "sharon", "cynthia",
      "kathleen", "amy", "angela", "shirley", "anna", "smith", "johnson", "williams", "brown",
      "jones", "garcia", "miller", "davis", "rodriguez", "martinez", "hernandez", "lopez",
      "gonzalez", "wilson", "anderson", "taylor", "moore", "jackson", "martin", "perez",
      "thompson", "white", "harris", "sanchez", "clark", "ramirez", "lewis", "robinson", "walker",
      "young", "allen", "king", "wright", "torres", "nguyen", "hill", "flores", "green", "adams",
      "nelson", "baker", "hall", "rivera", "campbell", "mitchell", "carter", "roberts"
    ],
    "allowlist_patterns": []
  },
  "scanners": [
    {
      "id": "phi-scan",
      "version": "0.7.0",
      "tool_ids": ["phi-scan"],
      "trigger_extensions": [".csv", ".tsv"],
      "input_extensions": [".csv", ".tsv"],
      "scope": "all_matching",
      "config_paths": [
        ".phi-scanner.yml", ".phi-scanbaseline", "dev-docs/privacy_tool_inventory.json"
      ]
    },
    {
      "id": "presidio",
      "version": "locked-privacy-scan-extra",
      "tool_ids": ["presidio", "spacy-english-model"],
      "trigger_extensions": [
        ".cfg", ".csv", ".html", ".ini", ".json", ".md", ".rst", ".svg", ".toml", ".tsv", ".txt",
        ".xml", ".yaml", ".yml"
      ],
      "input_extensions": [
        ".cfg", ".csv", ".html", ".ini", ".json", ".md", ".rst", ".svg", ".toml", ".tsv", ".txt",
        ".xml", ".yaml", ".yml"
      ],
      "scope": "all_matching",
      "config_paths": [
        "scripts/run_presidio_advisory.py", "dev-docs/privacy_tool_inventory.json", "pyproject.toml", "uv.lock"
      ]
    },
    {
      "id": "hounddog",
      "version": "local-standalone",
      "tool_ids": ["hounddog"],
      "trigger_extensions": [".py"],
      "trigger_prefixes": ["src/", "scripts/"],
      "diff_regex": "(?i)(log(?:ger|ging)?|print\\s*\\(|write|export|upload|request|http|api|database|sqlite|patient|identifier|dicom|rdsr|filename|filepath)",
      "input_extensions": [".py"],
      "input_prefixes": ["src/", "scripts/"],
      "scope": "all_matching",
      "config_paths": ["scripts/run_hounddog_advisory.py", "dev-docs/privacy_tool_inventory.json"]
    },
    {
      "id": "dicom-phi-scan",
      "version": "local-isolated",
      "tool_ids": ["dicom-phi-scan"],
      "trigger_extensions": [".dcm", ".dicom"],
      "input_extensions": [".dcm", ".dicom"],
      "scope": "changed",
      "config_paths": [
        "scripts/approved_asset_review.py", "scripts/run_dicom_phi_advisory.py",
        "dev-docs/approved_asset_inventory.json", "dev-docs/privacy_tool_inventory.json"
      ]
    },
    {
      "id": "image-ocr",
      "version": "local-tesseract",
      "tool_ids": ["tesseract", "poppler", "presidio", "pillow", "pypdf"],
      "trigger_extensions": [
        ".avif", ".bmp", ".docx", ".gif", ".heic", ".ipynb", ".jpeg", ".jpg", ".pdf", ".png", ".pptx",
        ".tif", ".tiff", ".webp", ".xlsx"
      ],
      "input_extensions": [
        ".avif", ".bmp", ".docx", ".gif", ".heic", ".ipynb", ".jpeg", ".jpg", ".pdf", ".png", ".pptx",
        ".tif", ".tiff", ".webp", ".xlsx"
      ],
      "scope": "changed",
      "config_paths": [
        "scripts/approved_asset_review.py", "scripts/run_image_privacy_advisory.py",
        "dev-docs/approved_asset_inventory.json", "dev-docs/privacy_tool_inventory.json", "pyproject.toml", "uv.lock"
      ]
    }
  ]
}
