# shellcheck shell=bash
# direnv config for GUISkinDose — auto-activates the uv-managed .venv on cd.
# Run `direnv allow` once to enable. Requires direnv (+ uv for venv creation).

# Re-evaluate when dependency definitions change.
watch_file pyproject.toml uv.lock

# Load local secrets/config from .env if present (e.g. SONAR_TOKEN, SONAR_HOST_URL).
# .env is gitignored; see .env.example for the template.
dotenv_if_exists .env

export VIRTUAL_ENV="$PWD/.venv"
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"

# Pin the local interpreter to the version PRs actually gate on. `requires-python`
# is >=3.11 and main/weekly cover 3.11-3.14, but a pull request builds 3.14 only
# (see matrix-prep in .github/workflows/ci.yml), so developing on anything else
# means version-specific breakage surfaces in CI instead of locally. It has
# happened: Python 3.14 changed `PurePath.suffix` for leading-dot names, which
# passed on 3.12 and failed both PR jobs.
#
# The 3.11 floor is only PARTLY covered without a second environment:
# `[tool.basedpyright] pythonVersion = "3.11"` is independent of the running
# interpreter but catches missing-API use, not differing runtime behaviour (the
# PurePath.suffix change that motivated this pin would have slipped through).
# For a runtime check against the floor, see the floor-check command in AGENTS.md
# — it must redirect UV_PROJECT_ENVIRONMENT, or `uv run --python 3.11` rebuilds
# this .venv as 3.11.
#
# Set through uv rather than a `.python-version` file on purpose: pyenv reads that
# filename too, and would fail on machines whose pyenv lacks 3.14.
export UV_PYTHON="${UV_PYTHON:-3.14}"

# Create the venv on first entry if it doesn't exist yet.
if [[ ! -d "$VIRTUAL_ENV" ]]; then
  if has uv; then
    log_status "creating .venv via uv"
    uv venv
  else
    log_error ".venv not found and uv is not installed; run: python -m venv .venv"
  fi
fi

# Put the venv on PATH (sets the activated environment without sourcing activate).
PATH_add "$VIRTUAL_ENV/bin"

# Keep dependencies in sync automatically. uv.lock is watched above, so this
# re-runs only when pyproject.toml/uv.lock change (uv is a near-noop otherwise).
if has uv; then
  log_status "uv sync --all-extras"
  uv sync --all-extras
else
  log_error "uv not installed; run: pip install -e \".[dev,gui]\""
fi
