# Example environment file for local development.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real tokens.
#
#   cp .env.example .env
#
# Load it however you prefer, e.g.:
#   set -a && source .env && set +a
# (direnv users: `.envrc` handles the venv; add `dotenv` there if you want auto-loading.)

# --- SonarQube / SonarCloud local analysis ---
# Auth token for the sonar-scanner. Generate under: My Account > Security in your Sonar instance.
SONAR_TOKEN=

# Server URL. SonarCloud: https://sonarcloud.io  |  local SonarQube: http://localhost:9000
SONAR_HOST_URL=http://localhost:9000
# (The local sonar helpers read this file themselves when the variables are
# not already exported — no `export` dance needed. Exported values always win.)

# --- SonarQube freshness gate (local hooks, opt-in) ---
# Hooks exit immediately when unset/off. Set to 1 to enforce a fresh local
# scan: the commit hook blocks once pending commits reach the budget
# (counting the in-flight commit), the push hook blocks on any commit since
# the last scan. State lives in tmp/sonar-state.json, written by
# scripts/run_sonarqube_local.py after each successful analysis.
# SONAR_FRESHNESS_GATE=0
# SONAR_GATE_MAX_COMMITS=10
# (Values may be quoted and carry trailing ' # comments'; the local sonar
# helpers strip both. An already-exported variable always wins over .env.)

# --- GUI: demo / non-clinical phantoms (not shipped) ---
# Demo STLs were removed from the package. The gate remains for future re-adds;
# enabling it has no effect unless demo_* meshes are restored under phantom_data/.
# See tmp/phantom_data_demo_stash/README.md on machines that kept a local stash.
# Precedence (highest first): process env GUISKINDOSE_SHOW_DEMO_PHANTOMS >
# process env MYPYSKINDOSE_SHOW_DEMO_PHANTOMS > .env GUISKINDOSE_SHOW_DEMO_PHANTOMS >
# .env MYPYSKINDOSE_SHOW_DEMO_PHANTOMS > .guiskindose.local.json / .mypyskindose.local.json >
# ~/.guiskindose/gui.json / ~/.mypyskindose/gui.json
# GUISKINDOSE_SHOW_DEMO_PHANTOMS=false
# MYPYSKINDOSE_SHOW_DEMO_PHANTOMS=false
