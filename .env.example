# Example environment file for local development.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real tokens.
#
#   cp .env.example .env
#
# Load it however you prefer, e.g.:
#   set -a && source .env && set +a
# (direnv users: `.envrc` handles the venv; add `dotenv` there if you want auto-loading.)

# --- SonarQube / SonarCloud local analysis ---
# Auth token for the sonar-scanner. Generate under: My Account > Security in your Sonar instance.
SONAR_TOKEN=

# Server URL. SonarCloud: https://sonarcloud.io  |  local SonarQube: http://localhost:9000
SONAR_HOST_URL=http://localhost:9000
