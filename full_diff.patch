+
+    def test_mixed_rows_have_heterogeneous_source_kinds(self):
+        data_parsed = pd.DataFrame(
+            {
+                "AcquisitionPlane": ["Plane A", "Plane B"],
+                "AcquisitionPlane_CodeValue": ["113620", "113621"],
